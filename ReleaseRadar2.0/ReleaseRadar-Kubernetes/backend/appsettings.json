{
  "Mode": "Demo",
  "Scan": {
    "IntervalSeconds": 600,
    "StaleAfterSeconds": 1200
  },
  "Kubernetes": {
    "Executable": "kubectl",
    "Context": "",
    "Namespace": "ns-gop-199419-prd-k8s",
    "TimeoutSeconds": 60
  },
  "GitHub": {
    "ApiBaseUrl": "https://sgithub.fr.world.socgen/api/v3/",
    "TimeoutSeconds": 45
  },
  "Defaults": {
    "TrunkBranch": "master",
    "ImageTagShaPattern": "^\\d{8}-\\d{6}-(?<sha>[0-9a-fA-F]{10})$"
